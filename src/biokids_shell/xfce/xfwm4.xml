<?xml version="1.0" encoding="UTF-8"?>
<!--
  The window manager for a child's session.

  Every shortcut that could close, move, resize or switch away from the kiosk
  window is unbound. They are set to "empty" rather than removed because xfwm4
  restores a missing key from its defaults; an explicitly empty binding stays
  empty.
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <property name="theme" type="string" value="Default"/>
    <property name="title_font" type="string" value="Sans Bold 9"/>
    <property name="button_layout" type="string" value="|"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
    <property name="cycle_workspaces" type="bool" value="false"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="borderless_maximize" type="bool" value="true"/>
    <property name="titleless_maximize" type="bool" value="true"/>
    <property name="mousewheel_rollup" type="bool" value="false"/>
    <property name="show_app_icon_menu" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="prevent_focus_stealing" type="bool" value="false"/>
    <property name="focus_new" type="bool" value="true"/>
  </property>
</channel>
