msgid "wizard.done.next.child.title"
msgstr "Çocuğunuz resmine tıklayarak girer"

msgid "wizard.done.next.child"
msgstr "Giriş ekranında kendi resmine tıklar; şifre gerekmez. İlk girişte Zio ve Sio ona BioKids'i anlatır."

msgid "wizard.done.next.panel.title"
