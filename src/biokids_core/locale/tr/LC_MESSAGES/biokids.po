# The guided first run, the restart banner and the help page (D-195)
msgid "remote.guide.1.title"
msgstr "Bu bilgisayarı bağlayın"

msgid "remote.guide.1.body"
msgstr "Aşağıdaki \"Telefondan erişimi aç\" düğmesine basın. BioKids, Tailscale'i bu bilgisayara kurar ve sizden bir kez giriş yapmanızı ister. Google, Apple ya da Microsoft hesabınızla girebilirsiniz; hesabınız yoksa ücretsiz açılır."

msgid "remote.guide.1.done"
msgstr "Bu bilgisayar Tailscale'e bağlı."

msgid "remote.guide.2.title"
msgstr "Telefondan erişime izin verin"

msgid "remote.guide.2.body"
msgstr "Bilgisayar bağlanınca BioKids paneli telefonunuza açar. Tailscale ilk seferde sizden bir onay isterse burada bir düğme çıkar."

msgid "remote.guide.2.done"
msgstr "Panel, Tailscale ağınızdaki cihazlara açık."

msgid "remote.guide.3.title"
msgstr "Telefonunuza Tailscale'i kurun"

msgid "remote.guide.3.body"
msgstr "Telefonunuzun kamerasıyla kendi mağazanızın kodunu okutun, Tailscale uygulamasını kurun ve bilgisayarda kullandığınız hesapla giriş yapın."

msgid "remote.guide.3.vpn"
msgstr "Telefon \"VPN bağlantısı ekle\" izni ister; izin verin. Bu yalnızca Tailscale'in kendi bağlantısıdır, diğer internet kullanımınız değişmez."

msgid "remote.guide.3.done"
msgstr "Telefonunuz bağlı: {names}"

msgid "remote.guide.4.title"
msgstr "Paneli telefonda açın"

msgid "remote.guide.4.body"
msgstr "Telefonunuzun kamerasıyla bu kodu okutun ve PIN'inizi girin. Tarayıcının menüsünden \"Ana ekrana ekle\"yi seçerseniz BioKids telefonunuzda bir uygulama gibi durur."

msgid "remote.guide.4.waiting"
msgstr "Önceki adımlar bitince panelin telefon adresi ve kodu burada görünecek."

msgid "wizard.done.next.restart.title"
msgstr "Bilgisayarı bir kez yeniden başlatın"

msgid "wizard.done.next.restart"
