#!/bin/sh
# BioKids at a parent's login (D-170, D-195, D-227).
#
# Run from /etc/xdg/autostart in every desktop session, and by biokids-panel's
# postinst (with --setup-only) in the sessions already open when BioKids is
# installed or upgraded. It does nothing for a child (their session is the
# launcher). For anyone else it:
#
#   * puts the BioKids background on their desktop, once (D-252);
#   * puts a "BioKids Parent Panel" shortcut on their desktop, once - deleted,
#     it stays deleted;
#   * opens in their browser what the panel's /at-login says: the setup wizard
#     while setup is not complete, then the panel itself at every login, unless
#     the family turned that off under Ayarlar. The parent closes the browser
#     to reach their own desktop. --setup-only opens the wizard and nothing
#     else, so that an upgrade does not pop the panel up in open sessions.
set -u

SETUP_ONLY=
[ "${1:-}" = "--setup-only" ] && SETUP_ONLY=1

case " $(id -nG 2>/dev/null) " in
    *" biokids-child "*) exit 0 ;;
esac

# ------------------------------------------------------- desktop background

# The logo on a parent's desktop (D-245, D-252), once, on every screen. Xfce
# 4.20 keeps a background per screen name and workspace and never looks at
# Debian's desktop-background. A parent who already chose one for any screen
# keeps theirs; changed afterwards, it stays changed. In the live session too:
# it is how the stick looks.
BACKGROUND=/usr/share/backgrounds/biokids/biokids-desktop.png
BACKGROUND_MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/biokids/desktop-background"

if [ -r "$BACKGROUND" ] && [ ! -e "$BACKGROUND_MARKER" ] \
        && command -v xfconf-query >/dev/null 2>&1 && command -v xrandr >/dev/null 2>&1; then
    settled=
    if xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -q '/workspace[0-9]*/last-image$'; then
        settled=1
    else
        for monitor in $(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 {print $NF}'); do
            for workspace in 0 1 2 3; do
                property=/backdrop/screen0/monitor$monitor/workspace$workspace
                xfconf-query -c xfce4-desktop -p "$property/last-image" -n -t string \
                    -s "$BACKGROUND" 2>/dev/null || continue
                xfconf-query -c xfce4-desktop -p "$property/image-style" -n -t int \
                    -s 5 2>/dev/null || true
                settled=1
            done
        done
    fi
    # No screen found (no display yet): the next login tries again.
    if [ -n "$settled" ]; then
        mkdir -p "$(dirname "$BACKGROUND_MARKER")" && : > "$BACKGROUND_MARKER"
    fi
fi

# Nothing else in a live session started from the BioKids stick (D-249): what
# is set up there is lost at the next boot, and the installer copies the stick,
# not the session.
[ -e /run/live/medium ] && exit 0

# --------------------------------------------------------- desktop shortcut

ENTRY=/usr/share/applications/biokids-panel.desktop
MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/biokids/desktop-shortcut"

if [ -r "$ENTRY" ] && [ ! -e "$MARKER" ]; then
    desktop=$(xdg-user-dir DESKTOP 2>/dev/null || true)
    if [ -n "$desktop" ] && [ "$desktop" != "$HOME" ] && [ -d "$desktop" ]; then
        shortcut="$desktop/biokids-panel.desktop"
        if cp "$ENTRY" "$shortcut" 2>/dev/null; then
            chmod 0755 "$shortcut"
            # Xfce 4.18 and later run a desktop launcher without asking only
            # when its checksum is recorded; GNOME asks for the trusted flag.
            sum=$(sha256sum "$shortcut" | cut -d' ' -f1)
            gio set "$shortcut" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
            gio set "$shortcut" metadata::trusted true 2>/dev/null || true
        fi
    fi
    mkdir -p "$(dirname "$MARKER")" && : > "$MARKER"
fi

# ------------------------------------------------- the wizard, or the panel

# The panel starts at boot; give it a moment if this login was quicker. It
# answers with a path on itself, or nothing when nothing is to be opened.
path=$(SETUP_ONLY="$SETUP_ONLY" python3 - <<'PY'
import json
import os
import sys
import time
import urllib.request

# The daemon may take a few minutes on a slow first boot (it renders the DNS
# blocklist before it says it is ready, and the panel waits for it).
for _ in range(90):
    try:
        with urllib.request.urlopen("http://127.0.0.1:7878/at-login", timeout=3) as answer:
            wanted = str(json.load(answer).get("open", ""))
        break
    except ValueError:
        sys.exit(0)
    except OSError:
        time.sleep(2)
else:
    sys.exit(0)
if os.environ.get("SETUP_ONLY") and not wanted.startswith("/wizard"):
    sys.exit(0)
# Only a path on the panel itself, whatever came back.
if wanted.startswith("/") and not wanted.startswith("//"):
    print(wanted)
PY
) || exit 0

[ -n "$path" ] || exit 0
exec xdg-open "http://127.0.0.1:7878$path"
