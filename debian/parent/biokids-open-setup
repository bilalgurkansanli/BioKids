#!/bin/sh
# BioKids at a parent's login (D-170, D-195).
#
# Run from /etc/xdg/autostart in every desktop session, and by biokids-panel's
# postinst in the sessions already open when BioKids is installed. It does
# nothing for a child (their session is the launcher). For anyone else it:
#
#   * puts a "BioKids Parent Panel" shortcut on their desktop, once - deleted,
#     it stays deleted;
#   * opens the setup wizard in their browser, for as long as setup is not
#     complete, which the panel says by sending "/" to the wizard.
set -u

case " $(id -nG 2>/dev/null) " in
    *" biokids-child "*) exit 0 ;;
esac

# --------------------------------------------------------- desktop shortcut

ENTRY=/usr/share/applications/biokids-panel.desktop
MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/biokids/desktop-shortcut"

if [ -r "$ENTRY" ] && [ ! -e "$MARKER" ]; then
    desktop=$(xdg-user-dir DESKTOP 2>/dev/null || true)
    if [ -n "$desktop" ] && [ "$desktop" != "$HOME" ] && [ -d "$desktop" ]; then
        shortcut="$desktop/biokids-panel.desktop"
        if cp "$ENTRY" "$shortcut" 2>/dev/null; then
            chmod 0755 "$shortcut"
            # Xfce 4.18 and later run a desktop launcher without asking only
            # when its checksum is recorded; GNOME asks for the trusted flag.
            sum=$(sha256sum "$shortcut" | cut -d' ' -f1)
            gio set "$shortcut" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
            gio set "$shortcut" metadata::trusted true 2>/dev/null || true
        fi
    fi
    mkdir -p "$(dirname "$MARKER")" && : > "$MARKER"
fi

# ------------------------------------------------------------- setup wizard

# The panel starts at boot; give it a moment if this login was quicker.
python3 - <<'PY' || exit 0
import sys
import time
import urllib.error
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


opener = urllib.request.build_opener(NoRedirect)
for _ in range(30):
    try:
        opener.open("http://127.0.0.1:7878/", timeout=3)
        sys.exit(1)  # answered without a redirect: nothing to set up
    except urllib.error.HTTPError as answer:
        location = answer.headers.get("Location", "")
        sys.exit(0 if "/wizard" in location else 1)
    except OSError:
        time.sleep(2)
sys.exit(1)
PY

exec xdg-open "http://127.0.0.1:7878/wizard/1"
