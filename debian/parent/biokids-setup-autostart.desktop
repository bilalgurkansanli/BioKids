[Desktop Entry]
# Opens the setup wizard in the browser of whoever logs in first after BioKids
# is installed (D-170), until setup is complete. /usr/lib/biokids/biokids-open-setup
# does nothing in a child's session and nothing once the family exists.
Type=Application
Name=BioKids setup
Name[tr]=BioKids kurulumu
Exec=/usr/lib/biokids/biokids-open-setup
TryExec=/usr/lib/biokids/biokids-open-setup
Terminal=false
NoDisplay=true
X-GNOME-Autostart-Delay=5
