[Desktop Entry]
# Opens the setup wizard in the browser of whoever logs in first after BioKids
# is installed (D-170), until setup is complete, and the parent panel at every
# parent login after that (D-227) unless the family turned it off under Ayarlar.
# /usr/lib/biokids/biokids-open-setup does nothing in a child's session.
Type=Application
Name=BioKids setup
Name[tr]=BioKids kurulumu
Exec=/usr/lib/biokids/biokids-open-setup
TryExec=/usr/lib/biokids/biokids-open-setup
Terminal=false
NoDisplay=true
X-GNOME-Autostart-Delay=5
