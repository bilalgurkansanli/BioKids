#!/bin/sh
# biokids-core postrm.
#
# The rule this script exists to enforce: removing BioKids must never destroy a
# family's history. "apt remove" leaves /var/lib/biokids exactly where it is, so
# that reinstalling brings back every quota, every setting and the audit log.
# Only "apt purge" may delete it, only after asking, and only on a clear yes.
#
# If debconf cannot ask - an unattended purge, a frontend that suppresses the
# question, a system where debconf is already gone - the answer is no and the
# data stays. Losing a directory that could have been deleted later is a
# nuisance; deleting one that should have been kept is not recoverable.

set -e

CONF_DIR=/etc/biokids
DATA_DIR=/var/lib/biokids
LOG_DIR=/var/log/biokids
RUN_DIR=/run/biokids

case "$1" in
    purge)
        purge_data=false
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_input high biokids-core/purge-data || true
            db_go || true
            db_get biokids-core/purge-data || true
            if [ "$RET" = "true" ]; then
                purge_data=true
            fi
        fi

        # The secrets were generated by the postinst, are ours alone, and mean
        # nothing once the database they protect is no longer in use. They go on
        # any purge, whatever the answer above was.
        rm -f "$CONF_DIR/ext.token" "$CONF_DIR/secret.key"

        if [ "$purge_data" = true ]; then
            rm -rf "$DATA_DIR"
            # The logs are part of the same record, so they follow the same
            # answer rather than getting a second question.
            rm -rf "$LOG_DIR"
        fi

        rmdir "$RUN_DIR" 2>/dev/null || true
        # Only if empty. A file an administrator put in /etc/biokids is theirs,
        # not ours to remove.
        rmdir "$CONF_DIR" 2>/dev/null || true

        # The biokids group and the biokids-ai user are deliberately left
        # behind. When the data directory is kept, something still owns it; and
        # Debian policy is not to reclaim system accounts on purge, because a
        # uid handed out again inherits whatever files carried the old one.
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
