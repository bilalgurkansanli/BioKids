[Unit]
Description=BioKids enforcement daemon
Documentation=https://github.com/bilalgurkansanli/BioKids
# Session state comes from logind. Without it the daemon has nothing to account
# against, so start after it rather than racing it.
After=systemd-logind.service
Wants=systemd-logind.service
# If the daemon ends up failed, lock the children out rather than leaving them
# unsupervised (D-106). Restart=always means this only fires once the start
# limit below is exhausted; ExecStopPost= covers the single crash.
OnFailure=biokids-lockdown.service
# Five crashes in a minute is a broken daemon, not a transient fault. Give up
# then, so that OnFailure= gets its turn.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# The daemon says READY=1 once it is supervising and WATCHDOG=1 after every
# tick that finished (D-172). A tick that hangs stops the pings: systemd kills
# the process, the ExecStopPost= lockdown below runs, and Restart= brings it
# back. Before this a hung daemon was "active (running)" and enforced nothing.
Type=notify
NotifyAccess=main
WatchdogSec=90s
# Rendering the 300,000-line blocklist at the first start takes a while on an
# old laptop.
TimeoutStartSec=180s
ExecStart=/usr/bin/biokids-daemon
Restart=always
RestartSec=2s
# Log lines are how a parent finds out what happened. Unbuffered, so the last
# one before a crash is actually in the journal.
Environment=PYTHONUNBUFFERED=1

# Restart=always revives the daemon instead of marking the unit failed, so
# OnFailure= alone would not fire on the first unclean exit - and the first
# unclean exit is exactly when a child is sitting in front of an unsupervised
# machine. Trip the lockdown from here too. The leading "-" keeps a failing
# lockdown from turning an otherwise clean restart into a failed unit; the
# OnFailure= line above is the second net.
ExecStopPost=-/bin/sh -c 'test "$$SERVICE_RESULT" = success || /usr/bin/biokids-admin lockdown'

# /run/biokids, holding daemon.sock. Created by systemd before ExecStart so the
# socket always has somewhere to live, and preserved across restarts so that a
# panel holding the path does not have it vanish underneath. The socket itself
# is chmod 0660 root:biokids by the daemon; the directory is traversable so a
# child's launcher can reach it.
RuntimeDirectory=biokids
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# SECURITY.md section 2, in full. This process is root and controls sessions,
# so everything it does not need is taken away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
# Root, with two of root's powers: nft needs CAP_NET_ADMIN (and netlink, below),
# and the daemon gives its socket to the biokids group with CAP_CHOWN. Locking,
# logging out and powering off are D-Bus calls to logind and systemd, which
# check the caller's uid and need no capability. Everything else root could do
# - read any file, kill any process, load a module - is gone, and every program
# the daemon runs (nft, loginctl, systemctl) inherits the same bound.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# The "-" prefix matters: a missing path in ReadWritePaths= is a unit that
# refuses to start. /etc/chromium/policies/managed is shipped empty by this
# package (biokids-daemon.dirs), because nothing else creates it: Debian's
# chromium does not, and a skipped entry leaves the daemon unable to write the
# kiosk policy with only a log line to say so. The DNS filter's files live under
# /var/lib/biokids/dns (D-167), so /etc/dnsmasq.d and /etc/nftables.d are not
# writable any more.
ReadWritePaths=/var/lib/biokids /run/biokids -/etc/chromium/policies/managed

[Install]
WantedBy=multi-user.target
