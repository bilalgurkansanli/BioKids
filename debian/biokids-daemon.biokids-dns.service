[Unit]
Description=BioKids DNS filter for children's accounts
Documentation=https://github.com/bilalgurkansanli/BioKids
# D-167. Answers the DNS questions of children's accounts only: nftables
# redirects their port 53 here, by the socket owner's uid, and nobody else's.
# It listens on loopback, port 5354, and is never a resolver for the network.
# biokids-daemon writes the configuration at every start and reload; until it
# has, there is nothing to run.
After=network.target
# Before the login screen, with the redirect the daemon last wrote: nftables
# rules do not survive a reboot, and the daemon loads them again only once it
# is up, which on the first VM was sixteen seconds after LightDM. A child's
# DNS went unfiltered in between.
Before=display-manager.service
ConditionPathExists=/var/lib/biokids/dns/dnsmasq.conf

[Service]
Type=simple
# "+": nftables needs CAP_NET_ADMIN, which the sandbox below takes away from
# dnsmasq itself. If the rules cannot load, dnsmasq does not start either.
ExecStartPre=+/usr/sbin/nft -f /var/lib/biokids/dns/biokids.nft
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --pid-file= --conf-file=/var/lib/biokids/dns/dnsmasq.conf
Restart=always
RestartSec=2s

# It starts as root to read its 0600 configuration and drops to the dnsmasq
# user (user= in the configuration). It needs no other privilege.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
