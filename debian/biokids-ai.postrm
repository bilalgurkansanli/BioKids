#!/bin/sh
# biokids-ai postrm.
#
# The models and the encyclopedia a parent downloaded are gigabytes. They are
# kept on "remove", so turning the assistant back on does not download them
# again, and deleted on purge.

set -e

case "$1" in
    purge)
        rm -rf /var/lib/biokids-ai
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
