#!/usr/bin/make -f
#
# BioKids: one source package, nine binary packages.
#
# The Python side is an ordinary pybuild build. Everything interesting here is
# about the split: pyproject.toml describes one project carrying the union of
# every component's dependencies, and this file takes that single installed tree
# apart into packages that each declare only what they really need. See
# debian/README.source for what could not be verified on the development host.
#
# PYBUILD_NAME is deliberately NOT set. pybuild reads it as "there is one
# binary package, python3-$NAME" and quietly swaps a --destdir of debian/tmp for
# debian/python3-biokids, a package that does not exist - so every .install
# file finds nothing and dh_install fails the build. That was the first real
# build's first error.
#
# pybuild also installs into the *versioned* python3.X/dist-packages and leaves
# dh_python3 to move it to python3/dist-packages later, after dh_install. That
# is why the .install files say `usr/lib/python3*/dist-packages`.

# The archive keyring needs a key that only exists at release time. Under this
# profile the package is not built at all (see debian/control) and the key is
# not required, which is what lets CI verify the other eight on every push.
NOKEYRING := $(filter pkg.biokids.nokeyring,$(DEB_BUILD_PROFILES))

# The test suite wants every runtime dependency at once, a session bus and a
# Linux clock. CI runs it on every push, long before a package is built; making
# the build depend on it again would only add build dependencies.
export PYBUILD_DISABLE=test

%:
	dh $@ --with python3 --buildsystem=pybuild

# Message catalogues are compiled at package time and never committed.
# biokids_core.i18n falls back to the .po when there is no .mo, which is what
# lets a developer see an edited string immediately; an installed system should
# not pay for that convenience on every lookup.
override_dh_auto_build:
	python3 dev/compile_i18n.py
	dh_auto_build

override_dh_auto_clean:
	dh_auto_clean
	rm -f src/biokids_core/locale/*/LC_MESSAGES/*.mo

# One tree for all nine packages; the .install files divide it up. Four things
# are placed here that pybuild knows nothing about:
#
#   * the application catalogue (D-20), which lives inside biokids_core as a
#     development fallback and at /usr/share/biokids/catalog for real
#     installations - which is where biokids_core.catalog looks first;
#
#   * the voice lines. VOICE.md section 5 makes them data rather than code and
#     puts them at /usr/share/biokids/voice/<locale>/<event>.txt, which is where
#     biokids_voice.lines looks before falling back to the copy inside the
#     wheel. Without this an administrator who edits the documented path edits a
#     file nobody reads;
#
#   * Zio and Sio, the character art. `CHARACTER_DIR` in biokids_shell points
#     two levels above the package, which is `assets/` in a checkout and
#     `/usr/lib/python3` on an installed machine - so without this the child's
#     first-run screen introduced "ben Zio" next to nothing and every speech
#     card had an empty character slot;
#
#   * the child's XFCE session configuration. Without it the user units are
#     installed with --no-enable and then nothing ever enables them: the child
#     logs in to an ordinary XFCE desktop with Alt+F4 and a file manager, the
#     launcher never starts, and the panel still says the child is managed;
#
#   * an alembic.ini whose script_location points at the installed package
#     rather than at ./src. Generated from the source tree's copy rather than
#     kept as a second file in debian/, so the two cannot drift. Neither carries
#     a database URL: migrations/env.py asks biokids_core.config for it, which
#     is what makes one ini correct in the postinst, in CI and under
#     BIOKIDS_PREFIX;
#
#   * the archive key, public half. Its absence is a hard failure on purpose: a
#     keyring package that ships no key is worse than one that will not build.
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

	install -d debian/tmp/usr/share/biokids/catalog
	install -m 0644 src/biokids_core/data/catalog/catalog.toml \
		debian/tmp/usr/share/biokids/catalog/catalog.toml

	set -e; for dir in src/biokids_core/data/voice/*/; do \
		locale="$$(basename "$$dir")"; \
		install -d debian/tmp/usr/share/biokids/voice/$$locale; \
		install -m 0644 $$dir*.txt \
			debian/tmp/usr/share/biokids/voice/$$locale/; \
	done

	install -d debian/tmp/usr/share/biokids/characters
	install -m 0644 assets/characters/*.svg 		debian/tmp/usr/share/biokids/characters/

	install -d debian/tmp/usr/share/biokids/xfce
	install -m 0644 src/biokids_shell/xfce/*.xml \
		debian/tmp/usr/share/biokids/xfce/
	install -m 0644 src/biokids_shell/xfce/*.desktop \
		debian/tmp/usr/share/biokids/xfce/

	# The big close button on every app window, and the rule that makes every
	# app window fill the screen so the button is always in one corner (D-163).
	install -d debian/tmp/usr/share/themes/BioKids/xfwm4
	install -m 0644 src/biokids_shell/xfce/theme/BioKids/xfwm4/* \
		debian/tmp/usr/share/themes/BioKids/xfwm4/
	install -d debian/tmp/usr/share/biokids/devilspie2
	install -m 0644 src/biokids_shell/devilspie2/*.lua \
		debian/tmp/usr/share/biokids/devilspie2/

	# The greeter's "is this a child who may come in by their picture?"
	# (D-155). Installed here rather than straight from a .install line because
	# it must be executable, and a checkout made on Windows cannot promise the
	# mode bit.
	install -d debian/tmp/usr/lib/biokids
	install -m 0755 debian/pam/biokids-child-login \
		debian/tmp/usr/lib/biokids/biokids-child-login

	sed -e 's,^script_location = .*,script_location = /usr/lib/python3/dist-packages/biokids_core/migrations,' \
	    -e '/^prepend_sys_path[[:space:]]*=/d' \
	    alembic.ini > debian/tmp/usr/share/biokids/alembic.ini
	chmod 0644 debian/tmp/usr/share/biokids/alembic.ini

ifeq (,$(NOKEYRING))
	@if [ ! -f debian/biokids-archive-keyring.asc ]; then \
		echo "debian/rules: debian/biokids-archive-keyring.asc is missing." >&2; \
		echo "  biokids-archive-keyring cannot be built without the real" >&2; \
		echo "  archive key. See debian/README.source, section 6." >&2; \
		echo "  To build everything else without it:" >&2; \
		echo "    dpkg-buildpackage -us -uc -b -Ppkg.biokids.nokeyring" >&2; \
		exit 1; \
	fi
	install -d debian/tmp/usr/share/keyrings
	gpg --batch --yes --dearmor \
		--output debian/tmp/usr/share/keyrings/biokids-archive-keyring.gpg \
		debian/biokids-archive-keyring.asc
	chmod 0644 debian/tmp/usr/share/keyrings/biokids-archive-keyring.gpg
else
	@echo "debian/rules: pkg.biokids.nokeyring is set; not building the keyring."
endif

# pyproject.toml declares the union of every component's requirements, so
# letting dh_python3 guess would put FastAPI into biokids-core's Depends and
# drag the panel onto a machine that only wanted the daemon. Each binary
# package names what it actually imports, by hand, in debian/control.
override_dh_python3:
	dh_python3 --no-guessing-deps

# Starting biokids-lockdown.service locks every child session. It is triggered
# by OnFailure= and must never be enabled or started because somebody ran apt.
#
# Two calls for one package, and the exact form of each matters:
#
#   * --name=biokids-lockdown reads debian/biokids-daemon.biokids-lockdown.service
#     and installs it as biokids-lockdown.service. --name changes the *source*
#     filename debhelper looks for, with no fallback, so the daemon's own unit
#     must NOT be named here: --name=biokids-daemon would look for
#     debian/biokids-daemon.biokids-daemon.service, find nothing, and ship a
#     daemon package with no unit at all.
#
# biokids-provision@.service is a template and gets the same treatment for the
# same reason: --name= picks the source filename, --no-enable/--no-start because
# a template has no instance to start, and biokids-panel.service is then named
# positionally so --remaining-packages does not act on the template.
#
#   * the second call names biokids-daemon.service as a positional argument
#     instead. That keeps the generated enable/start snippets scoped to it;
#     without the argument dh_installsystemd acts on every unit already in the
#     package build directory, which by then includes biokids-lockdown.service -
#     and starting that one locks every child session on install.
override_dh_installsystemd:
	dh_installsystemd -pbiokids-daemon --name=biokids-lockdown --no-enable --no-start
	dh_installsystemd -pbiokids-daemon biokids-daemon.service
	dh_installsystemd -pbiokids-daemon --name=biokids-dns
	dh_installsystemd -pbiokids-panel --name=biokids-provision@ --no-enable --no-start
	dh_installsystemd -pbiokids-panel biokids-panel.service
	dh_installsystemd -pbiokids-ai --name=biokids-ai-setup --no-enable --no-start
	dh_installsystemd -pbiokids-ai biokids-ai.service
	dh_installsystemd --remaining-packages

# The shell and the voice service belong to a child's session and are enabled
# there by the session configuration. Enabling them globally would start a kiosk
# launcher inside the parent's own desktop.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# Nothing may fall out of debian/tmp unnoticed: a module that silently stops
# being shipped is a package that silently stops working.
override_dh_missing:
	dh_missing --fail-missing
