#!/bin/sh
# biokids-daemon postrm.
#
# The daemon renders three configuration files that dpkg knows nothing about:
# a dnsmasq snippet, a Chromium managed policy and an nftables ruleset. They are
# generated from the database, carry a "do not hand-edit" header and are
# deliberately not conffiles - dpkg would otherwise prompt an administrator
# about a file no human wrote. Being outside dpkg's inventory, they have to be
# cleaned up here, or a purged system would keep filtering traffic on behalf of
# software that is no longer installed.
#
# The browser policy goes on "remove" as well as on purge. It is machine-wide:
# left behind, it kept the parent's own Chromium locked down after BioKids was
# gone (principle 4). The DNS redirect goes in the prerm for the same reason.

set -e

case "$1" in
    remove)
        rm -f /etc/chromium/policies/managed/biokids-kiosk.json
        ;;

    purge)
        rm -f /etc/dnsmasq.d/*biokids*
        rm -f /etc/chromium/policies/managed/*biokids*
        rm -f /etc/nftables.d/*biokids*
        # Ours, shipped empty; each goes only if nothing else put anything
        # there. /etc/chromium itself belongs to chromium.
        rmdir /etc/nftables.d 2>/dev/null || true
        rmdir /etc/chromium/policies/managed 2>/dev/null || true
        rmdir /etc/chromium/policies 2>/dev/null || true
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
