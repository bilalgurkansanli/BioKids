usr/bin/biokids-shell
usr/lib/python3*/dist-packages/biokids_shell
usr/share/biokids/characters
usr/share/biokids/xfce
usr/share/biokids/devilspie2
usr/share/themes/BioKids/xfwm4
# The virtual-terminal guards (D-136). In the packaged-defaults directories,
# not /etc: "apt remove" must take them away (principle 4), and an
# administrator can still override them from /etc.
debian/etc/systemd/logind.conf.d/biokids.conf usr/lib/systemd/logind.conf.d/
debian/etc/X11/xorg.conf.d/50-biokids-no-vt-switch.conf usr/share/X11/xorg.conf.d/

# A child logs in at the LightDM greeter by choosing their picture (D-99,
# D-155): a PAM service of our own, the helper it asks, and the one LightDM
# setting that selects the service and shows the user list.
debian/pam/biokids-lightdm etc/pam.d/
debian/pam/50-biokids.conf usr/share/lightdm/lightdm.conf.d/
# The login screen's look (D-170).
debian/greeter/50-biokids.conf usr/share/lightdm/lightdm-gtk-greeter.conf.d/
# The BioKids login screen (D-251), which LightDM runs as its greeter.
debian/greeter/biokids-greeter.desktop usr/share/xgreeters/
usr/lib/biokids/biokids-greeter
usr/share/biokids/greeter
usr/share/biokids/extension
usr/lib/biokids/biokids-child-login
