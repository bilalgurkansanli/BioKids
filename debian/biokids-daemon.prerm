#!/bin/sh
# biokids-daemon prerm: put the daemon down before its files go away.
#
# dh_installsystemd generates an equivalent stop into the debhelper block
# below. (Never write that block's marker in a comment: debhelper substitutes
# the first one it finds, so a comment mentioning it gets the generated code
# spliced into its middle - D-159.) It is written out here as well, first, because the order is what
# matters: the daemon has to be stopped before dpkg starts unlinking the Python
# modules it is running out of. A second stop of an already stopped unit costs
# nothing.
#
# A clean stop is not a failure, so this does not trip
# OnFailure=biokids-lockdown.service and nobody's session gets locked because an
# administrator ran apt.

set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop biokids-daemon.service >/dev/null 2>&1 || true
        fi
        # The children's DNS goes to the filter by an nftables rule (D-167).
        # Left behind, it would send every child's DNS to a filter that is no
        # longer there: a machine whose children have no internet at all after
        # BioKids was removed. Principle 4 says never.
        if command -v nft >/dev/null 2>&1; then
            nft destroy table inet biokids >/dev/null 2>&1 || true
        fi
        ;;

    upgrade|failed-upgrade)
        # Left running across an upgrade on purpose. The postinst restarts it,
        # and a child session that spends an apt run unsupervised is exactly
        # the gap this project exists to close.
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
