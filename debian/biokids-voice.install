usr/bin/biokids-voice
usr/lib/python3*/dist-packages/biokids_voice

# The lines Zio and Sio say, at the path VOICE.md section 5 documents and
# biokids_voice.lines reads before falling back to the copy inside the wheel.
# They belong here rather than in biokids-core: nothing but the voice service
# reads them, and a machine with no voice package has no use for them.
usr/share/biokids/voice
