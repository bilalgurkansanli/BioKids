# /var/log/biokids is created 0750 root:adm by biokids-core's postinst, and the
# daemon and the panel write into it. Two months of weekly history is enough for
# a parent to ask "what happened last month?"; the audit log a parent actually
# reads lives in the database and is not rotated away with these.
/var/log/biokids/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root adm
}
