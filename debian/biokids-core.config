#!/bin/sh
# debconf config script for biokids-core.
#
# Nothing is asked at installation time. This package has exactly one question -
# whether to delete a family's history - and it is asked from the postrm at
# purge, which is the moment the answer is needed and the moment somebody is
# actually deciding it.
#
# The script still has a job. It registers the template from the moment the
# package is unpacked, so an unattended installation can answer in advance with
# debconf-set-selections, and it clears the "seen" flag so that a second purge
# asks again instead of quietly reusing what was said the first time.

set -e

. /usr/share/debconf/confmodule

db_fset biokids-core/purge-data seen false || true

exit 0
