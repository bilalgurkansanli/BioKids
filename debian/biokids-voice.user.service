[Unit]
Description=BioKids voice companions, Zio and Sio
Documentation=https://github.com/bilalgurkansanli/BioKids
# A user unit in the child's session: speech needs the session's audio, and
# nothing here needs privileges. It ducks whatever else is playing while it
# speaks, which is only possible from inside the same PipeWire graph.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
# The child owns this. /var/lib/biokids is 0700 root — the family's history is
# not something a child's session may read — so the audio cache belongs in the
# child's own cache directory. systemd creates it 0700 before ExecStart and
# exports $CACHE_DIRECTORY, which is what synth.py looks for first.
CacheDirectory=biokids-voice
Type=simple
ExecStart=/usr/bin/biokids-voice
Restart=always
RestartSec=2s
Environment=PYTHONUNBUFFERED=1
# Piper uses every core while it makes a line it has not made before (D-254).
# The launcher and the app the child is touching come first: a line a moment
# later is better than a screen that stops answering while it is made.
Nice=5

# As in biokids-shell.service: a user unit gets what a user manager can
# actually apply. PrivateTmp= is left out on purpose - the PipeWire and
# PulseAudio sockets a child's session uses may live under /tmp, and a voice
# service that cannot reach them is a silent one.
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
